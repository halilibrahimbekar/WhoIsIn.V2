{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=whoisinv2;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "WhoIsInV2",
    "Audience": "WhoIsInV2.Client",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
